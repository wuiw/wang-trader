_SECTION_BEGIN("Price");
SetChartOptions(0,chartShowArrows|chartShowDates);
_N(Title = StrFormat("{{NAME}} - {{INTERVAL}} {{DATE}} Open %g, Hi %g, Lo %g, Close %g (%.1f%%) Vol " +WriteVal( V, 1.0 ) +" {{VALUES}}", O, H, L, C, SelectedValue( ROC( C, 1 )) ));
Plot( C, "Close", ParamColor("Color", colorBlack ), styleNoTitle | ParamStyle("Style") | GetPriceStyle() );
_SECTION_END();

_SECTION_BEGIN("ALMA");
function ALMA(priceField, windowSize, sigma, Offset)
{
    m = floor(Offset * (windowSize - 1));
    s = windowSize / sigma;

    w = 0;
    wSum = 0;

    for(i = 1; i < windowSize; i++)
    {
        w[i] = exp(-((i-m)*(i-m))/(s*s)); // 2 should be there?
        wSum += w[i];
    }

    for(i = 1; i < windowSize; i++)
    {
        w[i] = w[i] / wSum;
    }

    outalma = Null;

    for(j = 0; j < BarCount; j++)
    {
        alSum = 0;

        if(j < windowSize)
        {
            outalma[j] = Null;
        }
        else
        {
            for(i = 1; i < windowSize; i++)
            {
                alSum += priceField[j - (windowSize - 1 - i)] * w[i];
            }

            outalma[j] = alSum;
        }
    }

    return outalma;
}

price = ((High + Low) + 2 * (Open + Close)) / 6;

ALMA_short = ALMA(price, 15, 6, 0.85);
ALMA_long = ALMA(price, 30, 6, 0.85);

Plot(ALMA_short, "ALMA Short", ParamColor("Color Short", colorBlue), ParamStyle("Style"));
Plot(ALMA_long, "ALMA Long", ParamColor("Color Long", colorRed), ParamStyle("Style"));
_SECTION_END();

_SECTION_BEGIN("WANG");
CurrentTime = TimeNum();

current_WANG_highest_high = 0;
current_WANG_highest_low = 0;
WANG_unshielded_line_short = 0;
current_WANG_highest_index = 0;
current_WANG_lowest_high = 0;
current_WANG_lowest_low = 0;
WANG_unshielded_line_long =0;
current_WANG_lowest_index = 0;

during_WANG_short_transaction = False;
during_WANG_long_transaction = False;

reset_flag = False;

for(i = 2; i < BarCount; i++)
{
    // ---------------------------------  //
    // Normal WANG                          //
    // ---------------------------------  //
    debug1[i] = 0;
    debug2[i] = 0;

    normal_WANG_entry_point_short[i] = 0;
    normal_WANG_entry_point_long[i] = 0;

    if( i == 0 OR CurrentTime[i - 1] > CurrentTime[i] OR reset_flag == True)
    {
        reset_flag = False;

        current_WANG_highest_high = High[i];
        current_WANG_highest_low = Low[i];
        WANG_unshielded_line_short = Low[i];

        current_WANG_lowest_high = High[i];
        current_WANG_lowest_low = Low[i];
        WANG_unshielded_line_long = High[i];

        //during_WANG_long_transaction = False;
        //during_WANG_short_transaction = False;
    }
    else
    {
        if( High[i] >  current_WANG_highest_high )
        {
            current_WANG_highest_high = High[i];
            current_WANG_highest_low = Low[i];
            WANG_unshielded_line_short = Low[i];
            current_WANG_highest_index = i;

            //during_WANG_short_transaction = False;
        }
        else if( High[i] == current_WANG_highest_high AND Low[i] > current_WANG_highest_low )
        {
            current_WANG_highest_high = High[i];
            current_WANG_highest_low = Low[i];
            WANG_unshielded_line_short = Low[i];
            current_WANG_highest_index = i;

            //during_WANG_short_transaction = False;
        }

        if( Low[i] <  current_WANG_lowest_low )
        {
            current_WANG_lowest_high = High[i];
            current_WANG_lowest_low = Low[i];
            WANG_unshielded_line_long = High[i];
            current_WANG_lowest_index = i;

            //during_WANG_long_transaction = False;
        }
        else if( Low[i] == current_WANG_lowest_low AND High[i] < current_WANG_lowest_high )
        {
            current_WANG_lowest_high = High[i];
            current_WANG_lowest_low = Low[i];
            WANG_unshielded_line_long = High[i];
            current_WANG_lowest_index = i;

            //during_WANG_long_transaction = False;
        }

        if( Close[i] < WANG_unshielded_line_short AND
            High[i] < current_WANG_highest_low AND
            Close[i] < Open[i] AND
            Open[i] - Close[i] > Close[i] - Low[i])
        {
            normal_WANG_entry_point_short[i] = 1;
            //during_WANG_long_transaction = False;
            //during_WANG_short_transaction = True;

            current_WANG_lowest_high = High[i];
            current_WANG_lowest_low = Low[i];
            WANG_unshielded_line_long = High[i];
            current_WANG_lowest_index = i;

            reset_flag = True;
        }
        else if( Low[i] < WANG_unshielded_line_short )
        {
            WANG_unshielded_line_short = Low[i];
        }

        if( Close[i] > WANG_unshielded_line_long AND
            Low[i] > current_WANG_lowest_high AND
            Open[i] < Close[i] AND
            Close[i] - Open[i] > High[i] - Close[i])
        {
            normal_WANG_entry_point_long[i] = 1;
            //during_WANG_long_transaction = True;
            //during_WANG_short_transaction = False;

            current_WANG_highest_high = High[i];
            current_WANG_highest_low = Low[i];
            WANG_unshielded_line_short = Low[i];
            current_WANG_highest_index = i;

            reset_flag = True;
        }
        else if( High[i] > WANG_unshielded_line_long )
        {
            WANG_unshielded_line_long = High[i];
        }
    }
    // --------------------------------- //
    // End Normal WANG                      //
    // --------------------------------- //
}

PlotShapes( IIf( normal_WANG_entry_point_short == 1, shapeDownTriangle, shapeNone ), colorGreen );
PlotShapes( IIf( normal_WANG_entry_point_long == 1, shapeUpTriangle, shapeNone ), colorRed );

_SECTION_END();
