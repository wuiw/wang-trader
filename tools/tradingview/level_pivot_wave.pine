//@version=6
// =============================================================================
// 層級N 轉折峰谷點 ＋ 波形
//
// 定義來源：methods/期貨奇績2/q2-01-一分鐘穿越均線買賣策略.md §3.1（書 p.4–5 圖1-2／1-3、p.10 圖1-10、p.16–17 圖1-15）
//   峰點：峰價＝一組等高 high（⓪），平台前緊鄰 N 根、平台後緊鄰 N 根的 high 都嚴格較低。
//   平台：單峰（1 根）、雙峰／三峰（等高相鄰），等高 K 之間最多夾 1 根較低的 K（變形雙峰／變形三峰），長度不限。
//         夾 2 根以上就斷開，各自當獨立的峰判斷。谷點全部鏡像（縮腳變形雙谷／三谷）。
// 2026-10-03 使用者裁決：
//   1. 峰谷標在平台最右根。
//   2. 變形：等高 K 之間最多夾 1 根，長度不限（0x0、00x0、0x00、0x0x0、00x00 都算一個峰）。
//   3. 峰谷不交替時，兩峰之間補一個谷（區間最低 low，同低取較新），兩谷之間補一個峰（區間最高 high）。
//   4. 同一根同時是峰又是谷：兩個都留；前一個轉折是峰就先谷後峰，反之先峰後谷。
//   5. 左側不足 N 根時可往前一個交易段看（K 棒連續，不分段）。
//   6. 層級 N 可調，預設 1。
// 確認時點：平台最後一根之後第 N 根收盤。層級1 例外要等第 2 根：
//   「0 x 0」在層級1 時，第 1 個 0 的右邊已有 1 根較低，但下一根可能又等高而併成變形雙峰，所以多等 1 根。
// 只在確認當根畫，不重畫。
// =============================================================================
indicator("層級N 峰谷點＋波形", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

lvl      = input.int(1, "層級 N", minval = 1)
maxPlat  = input.int(200, "平台往左最多找幾根", minval = 2, maxval = 2000)
showMark = input.bool(true, "標示峰谷點")
showWave = input.bool(true, "畫波形")
showIns  = input.bool(true, "標示補的峰谷點")
waveCol  = input.color(color.new(color.orange, 0), "波形顏色")
waveW    = input.int(2, "波形線寬", minval = 1)

// 平台最右根到確認棒的距離
k = lvl >= 2 ? lvl : 2

// 以 offset k 的 K 棒為平台最右根，判斷是否成立峰（isPeak=true）或谷
f_check(bool isPeak) =>
    float P = isPeak ? high[k] : low[k]
    bool ok = not na(P) and bar_index - k - lvl >= 0
    // 右側緊鄰 N 根嚴格較低（谷：較高）
    if ok
        for i = 1 to lvl
            float v = isPeak ? high[k - i] : low[k - i]
            if na(v) or (isPeak ? v >= P : v <= P)
                ok := false
                break
    // 層級1：再下一根不可等高（否則會併成變形雙峰）
    if ok and lvl == 1
        float v2 = isPeak ? high[0] : low[0]
        if v2 == P
            ok := false
    // 往左找平台起點：等高相鄰，或隔 1 根較低後又等高
    int j = k
    if ok
        while j - k < maxPlat
            float a = isPeak ? high[j + 1] : low[j + 1]
            float b = isPeak ? high[j + 2] : low[j + 2]
            if a == P
                j += 1
            else if not na(a) and (isPeak ? a < P : a > P) and b == P
                j += 2
            else
                break
    // 左側緊鄰 N 根嚴格較低
    if ok
        if bar_index - j - lvl < 0
            ok := false
        else
            for i = 1 to lvl
                float v = isPeak ? high[j + i] : low[j + i]
                if na(v) or (isPeak ? v >= P : v <= P)
                    ok := false
                    break
    [ok, P]

[isPk, pkPx] = f_check(true)
[isTr, trPx] = f_check(false)
int pivBar = bar_index - k

plotshape(showMark and isPk, "峰", shape.triangledown, location.abovebar, color.new(color.blue, 0), offset = -k, size = size.tiny)
plotshape(showMark and isTr, "谷", shape.triangleup, location.belowbar, color.new(color.green, 0), offset = -k, size = size.tiny)

// ---- 波形 ----
type WaveState
    int   typ   = 0      // 1＝峰、-1＝谷、0＝尚無
    int   bar   = na
    float price = na

var WaveState ws = WaveState.new()

f_move(WaveState st, int typ, int b, float p) =>
    if showWave and not na(st.bar)
        line.new(st.bar, st.price, b, p, xloc.bar_index, extend.none, waveCol, line.style_solid, waveW)
    st.typ := typ
    st.bar := b
    st.price := p

f_add(WaveState st, int typ, int b, float p) =>
    if st.typ == typ
        // 同類連續：兩峰之間補最低 low 當谷，兩谷之間補最高 high 當峰；同價取較新
        int oNew = bar_index - b + 1
        int oOld = bar_index - st.bar - 1
        int   ib = na
        float ip = na
        if oOld >= oNew
            for o = oNew to oOld
                float v = typ == 1 ? low[o] : high[o]
                if na(ip) or (typ == 1 ? v < ip : v > ip)
                    ip := v
                    ib := bar_index - o
        if not na(ib)
            if showIns
                label.new(ib, ip, "", xloc.bar_index, yloc.price, waveCol, label.style_circle, size = size.tiny)
            f_move(st, -typ, ib, ip)
    f_move(st, typ, b, p)

if isPk and isTr
    if ws.typ == 1
        f_add(ws, -1, pivBar, trPx)
        f_add(ws, 1, pivBar, pkPx)
    else
        f_add(ws, 1, pivBar, pkPx)
        f_add(ws, -1, pivBar, trPx)
else if isPk
    f_add(ws, 1, pivBar, pkPx)
else if isTr
    f_add(ws, -1, pivBar, trPx)
